# Copie pra .env (que fica fora do git -- ver .gitignore) e preencha
# com os valores reais. Nunca commitar .env de verdade.

# --- Banco de dados (Postgres) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=moneta_app
DB_PASSWORD=
DB_NAME=moneta

# --- Autenticação ---
JWT_SECRET=
SESSION_SECRET=

# --- Dado sensível cifrado em repouso (salário do usuário) ---
SALARY_ENCRYPTION_KEY=

# --- Frontend (CORS, links de e-mail) ---
FRONTEND_URL=http://localhost:5173

# --- Login com Google (opcional -- sem isso, "Entrar com Google" fica
#     desativado, o resto do app funciona normal) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cotação de ações/fundos imobiliários via brapi.dev (opcional --
#     sem isso, funciona só pros tickers de teste da brapi -- PETR4,
#     MGLU3, VALE3, ITUB4 -- com limite de 20 req/min por IP; com o
#     token, qualquer ticker e sem esse limite por minuto. Cripto via
#     CoinGecko não precisa de token nenhum). ---
BRAPI_TOKEN=

# --- Agente de IA (opcional -- defina UMA das três, nunca mais de uma.
#     Sem nenhuma, o agente usa o interpretador local por regex, sem
#     chamada de rede nenhuma. Ver src/agent/AILayer.js). ---
XAI_API_KEY=
# XAI_MODEL=grok-4-fast
#
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# Força o interpretador local mesmo com uma chave acima preenchida --
# útil pra já deixar a chave configurada sem o sistema ficar tentando
# chamá-la (ex.: conta criada, aguardando crédito ativar). true pra
# desativar, tire a linha (ou false) pra voltar a tentar a chave.
# AI_AGENT_DISABLED=true
